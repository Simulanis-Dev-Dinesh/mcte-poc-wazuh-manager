# Wazuh dashboard configuration, rendered by Ansible (CyberRangeCZ provisioning).
server.host: "0.0.0.0"
server.port: {{ wazuh_dashboard_port }}
server.name: "wazuh-dashboard"

opensearch.hosts: ["{{ wazuh_dashboard_indexer_url }}"]
{% if wazuh_dashboard_indexer_security == 'yes' %}
opensearch.ssl.verificationMode: {{ wazuh_dashboard_ssl_verify }}
opensearch.username: "{{ wazuh_dashboard_indexer_user }}"
opensearch.password: "{{ wazuh_dashboard_indexer_password }}"
opensearch.requestHeadersWhitelist: [ authorization, securitytenant ]
{% endif %}
{% if wazuh_dashboard_ssl == 'yes' %}

server.ssl.enabled: true
server.ssl.certificate: /etc/wazuh-dashboard/certs/dashboard.pem
server.ssl.key: /etc/wazuh-dashboard/certs/dashboard-key.pem
{% endif %}

# No opensearch_security.* keys: this dashboard version rejects some of them
# (read_guard_modal, multitenancy) and refuses to start. The security plugin
# is disabled on the indexer for the POC anyway.

newsfeed.enabled: false
telemetry.optIn: false
telemetry.enabled: false
